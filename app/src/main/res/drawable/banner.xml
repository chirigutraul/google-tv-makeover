<?xml version="1.0" encoding="utf-8"?>
<!-- 320x180 launcher banner: dark glass tile with a white dock bar -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="320dp" android:height="180dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FF3A2A24" android:endColor="#FF0E0B0A" />
        </shape>
    </item>
    <item android:width="200dp" android:height="36dp" android:gravity="center_horizontal|bottom" android:bottom="28dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#40FFFFFF" />
        </shape>
    </item>
</layer-list>
